{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "types": ["node"]
    },
    "include": ["src", "playwright.config.ts", "koslibs-builder.ts"]
}
